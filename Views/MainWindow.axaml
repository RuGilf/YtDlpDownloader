<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YtDlpDownloader.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="600"
        x:Class="YtDlpDownloader.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="YtDlp Downloader"
        Width="750" Height="600"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark" 
        Background="#18181B">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">

        <!-- ================= БЛОК 1: ВВОД ССЫЛКИ ================= -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Ссылка на видео или плейлист:" 
                       Foreground="#E4E4E7" 
                       FontSize="14" 
                       FontWeight="SemiBold"/>
            
            <Grid ColumnDefinitions="*, 150">
                <TextBox Grid.Column="0"
                         Text="{Binding VideoUrl}"
                         PlaceholderText="https://..."
                         Height="40"
                         VerticalContentAlignment="Center"
                         CornerRadius="4"
                         FontSize="14"
                         IsEnabled="{Binding !IsDownloading}"/>
                
                <Button Grid.Column="1"
                        Content="Анализировать"
                        Command="{Binding AnalyzeVideoCommand}"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Height="40"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        CornerRadius="4"
                        IsEnabled="{Binding !IsDownloading}"/>
            </Grid>

            <!-- Полоса загрузки (поиск видео) -->
            <ProgressBar IsIndeterminate="True" 
                         Height="4" 
                         Margin="0,5,0,0"
                         Foreground="#2563EB"
                         Background="Transparent"
                         IsVisible="{Binding IsLoading}"/>
        </StackPanel>


        <!-- ================= БЛОК 2: ИНФОРМАЦИЯ О ВИДЕО ================= -->
        <Border Grid.Row="1" 
                Background="#27272A" 
                BorderBrush="#3F3F46" 
                BorderThickness="1" 
                CornerRadius="6" 
                Margin="0,20">
            <Panel>
                
                <!-- Состояние 1: Пусто (Ожидание ввода) -->
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Spacing="10"
                            IsVisible="{Binding CurrentVideo, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="Вставьте ссылку и нажмите «Анализировать»" 
                               Foreground="#A1A1AA" 
                               FontSize="16" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Поддерживаются YouTube, VK, Rutube и другие" 
                               Foreground="#71717A" 
                               FontSize="13" 
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Состояние 2: Видео найдено -->
                <Grid IsVisible="{Binding CurrentVideo, Converter={x:Static ObjectConverters.IsNotNull}}" 
                      ColumnDefinitions="Auto, *" 
                      Margin="20">
                    
                    <!-- Превью видео (Левая колонка, пропорции 16:9) -->
                    <Border Grid.Column="0" 
                            Width="240" Height="135" 
                            Background="#18181B" 
                            CornerRadius="4" 
                            BorderBrush="#3F3F46" 
                            BorderThickness="1"
                            ClipToBounds="True"
                            VerticalAlignment="Top">
                        <Panel>
                            <!-- Заглушка (показывается если картинка еще грузится или отсутствует) -->
                            <PathIcon Data="M17,10.5V7A1,1,0,0,0,16,6H4A1,1,0,0,0,3,7v10a1,1,0,0,0,1,1H16a1,1,0,0,0,1-1V13.5l4,4V6.5Z"
                                      Width="40" Height="40" 
                                      Foreground="#52525B"
                                      IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                            
                            <!-- Реальное превью из интернета -->
                            <Image Source="{Binding PreviewImage}" 
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </Panel>
                    </Border>

                    <!-- Детали и выбор формата (Правая колонка) -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="8">
                        <TextBlock Text="{Binding CurrentVideo.Title}" 
                                   Foreground="#F4F4F5" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   TextWrapping="Wrap" 
                                   MaxLines="3" 
                                   TextTrimming="CharacterEllipsis"/>
                        
                        <TextBlock Text="{Binding CurrentVideo.Author}" 
                                   Foreground="#A1A1AA" 
                                   FontSize="14"/>
                        
                        <TextBlock Text="{Binding CurrentVideo.Duration, StringFormat='Длительность: {0}'}" 
                                   Foreground="#A1A1AA" 
                                   FontSize="14"/>

                        <Border Height="1" Background="#3F3F46" Margin="0,10"/>

                        <!-- Выбор качества -->
                        <TextBlock Text="Выберите качество:" 
                                   Foreground="#E4E4E7" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"/>
                        
                        <ComboBox ItemsSource="{Binding CurrentVideo.AvailableFormats}" 
                                  SelectedItem="{Binding SelectedFormat}"
                                  HorizontalAlignment="Stretch"
                                  Height="40"
                                  CornerRadius="4">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="120, 80, *">
                                        <TextBlock Grid.Column="0" Text="{Binding Resolution}" Foreground="#F4F4F5" FontWeight="Medium"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Extension}" Foreground="#A1A1AA"/>
                                        <TextBlock Grid.Column="2" Text="{Binding FileSize}" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>


        <!-- ================= БЛОК 3: ЗАГРУЗКА И СТАТУС ================= -->
        <StackPanel Grid.Row="2" Spacing="10">

            <!-- ВЫБОР ПАПКИ СОХРАНЕНИЯ -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                <TextBlock Text="{Binding DownloadFolderPath, StringFormat='Сохранить в: {0}'}" 
                           Foreground="#A1A1AA" 
                           FontSize="13" 
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" 
                        Content="Обзор..." 
                        Command="{Binding ChangeFolderCommand}"
                        Margin="15,0,0,0"
                        Padding="15,0"
                        Height="32"
                        VerticalContentAlignment="Center"
                        Background="#27272A"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        Foreground="#F4F4F5"
                        FontSize="12"
                        CornerRadius="4"
                        IsEnabled="{Binding !IsDownloading}"/>
            </Grid>
            
            <TextBlock Text="{Binding StatusText}" 
                       Foreground="#A1A1AA" 
                       FontSize="13" 
                       HorizontalAlignment="Left"/>

            <Grid>
                <!-- Кнопка скачивания -->
                <Button Content="Скачать видео" 
                        Command="{Binding DownloadVideoCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Height="50"
                        Background="#10B981" 
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        CornerRadius="4"
                        IsEnabled="{Binding SelectedFormat, Converter={x:Static ObjectConverters.IsNotNull}}"
                        IsVisible="{Binding !IsDownloading}"/>

                <!-- Прогресс загрузки -->
                <Grid IsVisible="{Binding IsDownloading}" ColumnDefinitions="*, Auto" Height="50">
                    <ProgressBar Grid.Column="0"
                                 Minimum="0" Maximum="100" 
                                 Value="{Binding DownloadProgress}" 
                                 Height="20"
                                 Foreground="#10B981"
                                 Background="#27272A"
                                 BorderBrush="#3F3F46"
                                 BorderThickness="1"
                                 CornerRadius="4"
                                 VerticalAlignment="Center"/>
                    
                    <TextBlock Grid.Column="1"
                               Text="{Binding DownloadProgress, StringFormat='{}{0}%'}"
                               Foreground="#F4F4F5"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="15,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
            
        </StackPanel>
    </Grid>
</Window>