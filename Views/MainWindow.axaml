<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:vm="using:YtDlpDownloader.ViewModels"
                 xmlns:models="using:YtDlpDownloader.Models"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
                 x:Class="YtDlpDownloader.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Title="YtDlp Downloader"
                 Width="850" Height="700"
                 WindowStartupLocation="CenterScreen">

    <suki:SukiWindow.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="suki|GlassCard">
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
    </suki:SukiWindow.Styles>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="24">

        <!-- ================= ШАПКА ПРИЛОЖЕНИЯ ================= -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Text="Загрузчик видео" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" 
                    Content="🌓 Сменить тему" 
                    Click="ToggleTheme_Click"
                    Classes="Basic" 
                    FontSize="14"/>
        </Grid>

        <!-- ================= БЛОК ВВОД ССЫЛКИ ================= -->
        <suki:GlassCard Grid.Row="1" Padding="16,12" Margin="0,0,0,16">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding VideoUrl}"
                             PlaceholderText="Вставьте ссылку на видео или плейлист (https://...)"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             FontSize="14"/> 
                    
                    <Button Grid.Column="1"
                            Content="Анализировать"
                            Command="{Binding AnalyzeVideoCommand}"
                            Classes="Flat Primary"
                            Margin="12,0,0,0"
                            Width="140" Height="36"
                            FontWeight="Medium"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>

                <ProgressBar IsIndeterminate="True" 
                             Height="3" 
                             Classes="Accent"
                             CornerRadius="2"
                             IsVisible="{Binding IsLoading}"/>
            </StackPanel>
        </suki:GlassCard>

        <!-- ================= ЦЕНТРАЛЬНЫЙ БЛОК КОНТЕНТА ================= -->
        <Grid Grid.Row="2">
            
            <!-- ВАРИАНТ А: Карточка видео -->
            <suki:GlassCard IsVisible="{Binding CurrentVideo, Converter={x:Static ObjectConverters.IsNotNull}}" Padding="24" VerticalAlignment="Top">
                <Grid ColumnDefinitions="Auto, *">
                    <!-- Превью -->
                    <Border Grid.Column="0" 
                            Width="260" Height="146" 
                            CornerRadius="10" 
                            ClipToBounds="True"
                            VerticalAlignment="Top"
                            BoxShadow="0 8 20 0 #60000000">
                        <Panel>
                            <Rectangle Fill="{DynamicResource SukiBackground}" />
                            <PathIcon Data="M17,10.5V7A1,1,0,0,0,16,6H4A1,1,0,0,0,3,7v10a1,1,0,0,0,1,1H16a1,1,0,0,0,1-1V13.5l4,4V6.5Z"
                                      Width="40" Height="40" 
                                      Opacity="0.3"
                                      IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                            <Image Source="{Binding PreviewImage}" 
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </Panel>
                    </Border>

                    <!-- Описание и динамические ComboBox -->
                    <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="8">
                        <TextBlock Text="{Binding CurrentVideo.Title}" 
                                   FontSize="20" FontWeight="SemiBold" 
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        
                        <TextBlock Text="{Binding CurrentVideo.Author}" Opacity="0.6" FontSize="14" FontWeight="Medium"/>
                        <TextBlock Text="{Binding CurrentVideo.Duration, StringFormat='Длительность: {0}'}" Opacity="0.5" FontSize="13"/>

                        <Border Height="1" Background="{DynamicResource SukiControlBorderBrush}" Margin="0,10"/>

                        <!-- Сетка динамического выбора параметров -->
                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,5" HorizontalAlignment="Stretch">
                            <!-- 1. Качество видео -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12" Spacing="4">
                                <TextBlock Text="Разрешение:" FontSize="12" Opacity="0.6" FontWeight="Medium"/>
                                <ComboBox ItemsSource="{Binding Resolutions}"
                                          SelectedItem="{Binding SelectedResolution}"
                                          HorizontalAlignment="Stretch"
                                          Height="38"
                                          CornerRadius="6"/>
                            </StackPanel>

                            <!-- 2. Формат контейнера -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12" Spacing="4">
                                <TextBlock Text="Формат файла:" FontSize="12" Opacity="0.6" FontWeight="Medium"/>
                                <ComboBox ItemsSource="{Binding Containers}"
                                          SelectedItem="{Binding SelectedContainer}"
                                          HorizontalAlignment="Stretch"
                                          Height="38"
                                          CornerRadius="6"/>
                            </StackPanel>

                            <!-- 3. Выбор субтитров -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Spacing="4">
                                <TextBlock Text="Субтитры:" FontSize="12" Opacity="0.6" FontWeight="Medium"/>
                                <ComboBox ItemsSource="{Binding Subtitles}"
                                          SelectedItem="{Binding SelectedSubtitle}"
                                          HorizontalAlignment="Stretch"
                                          Height="38"
                                          CornerRadius="6"/>
                            </StackPanel>

                            <!-- 4. Выбор аудиодорожки (дубляж) -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Spacing="4">
                                <TextBlock Text="Аудиодорожка:" FontSize="12" Opacity="0.6" FontWeight="Medium"/>
                                <ComboBox ItemsSource="{Binding AudioTracks}"
                                          SelectedItem="{Binding SelectedAudioTrack}"
                                          HorizontalAlignment="Stretch"
                                          Height="38"
                                          CornerRadius="6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Панель опций -->
                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,12">
                            <CheckBox Content="Встроить тэги метаданных" IsChecked="{Binding EmbedMetadata}"/>
                            <CheckBox Content="Встроить обложку" IsChecked="{Binding EmbedThumbnail}"/>
                        </StackPanel>

                        <!-- ДВЕ КНОПКИ: Назад и Добавить в очередь -->
                        <Grid ColumnDefinitions="*, *" Margin="0,5">
                            <Button Grid.Column="0"
                                    Content="Назад к очереди" 
                                    Command="{Binding CancelAnalysisCommand}"
                                    Classes="Basic"
                                    Height="40"
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>
                            
                            <Button Grid.Column="1"
                                    Content="Добавить в очередь" 
                                    Command="{Binding AddToQueueCommand}"
                                    Classes="Flat Accent"
                                    Height="40"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </suki:GlassCard>

            <!-- ВАРИАНТ Б: Очередь загрузок -->
            <suki:GlassCard IsVisible="{Binding CurrentVideo, Converter={x:Static ObjectConverters.IsNull}}" Padding="0">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="0,0,0,1" Padding="20,16" CornerRadius="16,16,0,0">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <TextBlock Grid.Column="0" Text="Очередь загрузок" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding QueueTasks.Count, StringFormat='Задач: {0}'}" Opacity="0.5" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            
                            <Button Grid.Column="2" 
                                    Content="Очистить" 
                                    Command="{Binding ClearQueueCommand}"
                                    Classes="Basic" 
                                    Foreground="#FF3B30"
                                    FontSize="13" 
                                    FontWeight="Medium"
                                    Padding="12,6"
                                    IsEnabled="{Binding !IsDownloading}"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding QueueTasks}" 
                             Background="Transparent" 
                             BorderThickness="0"
                             Padding="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Template>
                            <ControlTemplate>
                                <Panel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </ScrollViewer>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !QueueTasks.Count}">
                                        <PathIcon Data="M19,9H15V3H9V9H5L12,16L19,9M5,18V20H19V18H5Z" Width="32" Height="32" Opacity="0.2"/>
                                        <TextBlock Text="Очередь пуста" Opacity="0.4" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Panel>
                            </ControlTemplate>
                        </ListBox.Template>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:DownloadTask">
                                <Border Background="{DynamicResource SukiControlBorderBrush}" CornerRadius="10" Margin="0,4" Padding="12">
                                    <Grid ColumnDefinitions="Auto, *, Auto" Height="54">
                                        
                                        <!-- Превью -->
                                        <Border Grid.Column="0" Width="96" Height="54" CornerRadius="6" ClipToBounds="True" BoxShadow="0 2 8 0 #40000000">
                                            <Panel>
                                                <Rectangle Fill="{DynamicResource SukiBackground}" />
                                                <PathIcon Data="M17,10.5V7A1,1,0,0,0,16,6H4A1,1,0,0,0,3,7v10a1,1,0,0,0,1,1H16a1,1,0,0,0,1-1V13.5l4,4V6.5Z"
                                                          Width="20" Height="20" Opacity="0.3"
                                                          IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>
                                            </Panel>
                                        </Border>

                                        <!-- Прогресс -->
                                        <Grid Grid.Column="1" RowDefinitions="*, *" Margin="16,0" VerticalAlignment="Center">
                                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Medium" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Options.Resolution}" Opacity="0.6" FontSize="12"/>
                                                    <TextBlock Text="{Binding Options.Container}" Foreground="{DynamicResource SukiPrimaryColor}" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                                                <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="4" Classes="Accent" CornerRadius="2"
                                                             IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DownloadStatus.Downloading}}"/>
                                                
                                                <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                                           Text="В очереди" Opacity="0.4" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DownloadStatus.Pending}}"/>
                                                <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                                           Text="Завершено" Foreground="#34C759" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DownloadStatus.Completed}}"/>
                                                <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                                           Text="Ошибка" Foreground="#FF3B30" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DownloadStatus.Failed}}"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0,0,0"
                                                            IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DownloadStatus.Downloading}}">
                                                    <TextBlock Text="{Binding Speed}" Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RemainingTime}" Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- Удаление задачи -->
                                        <Button Grid.Column="2" 
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveTaskCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="Basic" Width="32" Height="32"
                                                CornerRadius="16"
                                                IsEnabled="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsDownloading}">
                                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="12" Height="12" Foreground="#FF3B30" Opacity="0.8"/>
                                        </Button>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </suki:GlassCard>
            
        </Grid>

        <!-- ================= НИЖНИЙ БЛОК ================= -->
        <StackPanel Grid.Row="3" Spacing="16" Margin="0,16,0,0">

            <!-- Изменение папки -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.6">
                    <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" Width="16" Height="16"/>
                    <TextBlock Text="{Binding DownloadFolderPath}" 
                               FontSize="13" 
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        Content="Выбрать папку" 
                        Command="{Binding ChangeFolderCommand}"
                        Classes="Basic"
                        FontSize="13"
                        FontWeight="Medium"/>
            </Grid>

            <!-- Старт скачивания / Ход работы -->
            <Panel Height="48">
                <Button Content="Начать загрузку" 
                        Command="{Binding StartDownloadCommand}"
                        Classes="Flat Primary"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        FontSize="15" FontWeight="SemiBold"
                        IsEnabled="{Binding !IsDownloading}"
                        IsVisible="{Binding !IsDownloading}"/>

                <suki:GlassCard Padding="20,0" CornerRadius="8"
                                IsVisible="{Binding IsDownloading}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid ColumnDefinitions="*, Auto, Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Идёт загрузка очереди..." FontSize="14" FontWeight="Medium" Opacity="0.9" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" Height="4" Classes="Accent" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        
                        <!-- Кнопка принудительной остановки скачивания -->
                        <Button Grid.Column="2" 
                                Content="Остановить" 
                                Command="{Binding StopDownloadCommand}"
                                Classes="Basic" 
                                Foreground="#FF3B30"
                                FontSize="12"
                                FontWeight="Bold"
                                Padding="12,6"/>
                    </Grid>
                </suki:GlassCard>
            </Panel>
            
        </StackPanel>
    </Grid>
</suki:SukiWindow>